        "keys/test-only-issuer-jwks.json",
        "--expect-slug",
        "fixture-org",
        "--expect-issuer",
        "https://issuer.test",
        "--now",
        "1767225900"
      ],
      "expect": {
        "exit": 0,
        "code": "verified",
        "match": "VERIFIED — this document was signed"
      },
      "canonical_sha256": "fe8b07a0e89e219fc53384aedb0c3bd65038946e1e31e2352486caa77d610571"
    },
    {
      "id": "valid-jws-claims",
